<!-- Wizard CSS - Load before content -->
<link rel="stylesheet" href="/public/css/wizard.css" />
<link rel="stylesheet" href="/public/css/modal.css" />
<link rel="stylesheet" href="/public/css/responsive.css" />

<!-- Skip to content link for accessibility -->
<a href="#wizard-container" class="skip-to-content">Skip to content</a>

<!-- Wizard toolbar -->
<div class="wizard-toolbar">
	<button id="btn-wizard-reset" class="btn btn-sm btn-danger" title="Clear all wizard progress and start over">
		<span aria-hidden="true">🔄</span> Reset Wizard
	</button>
</div>

<!-- Main wizard container -->
<div id="wizard-container">
	<!-- Error/message area - visible alerts -->
	<div id="wizard-errors" aria-live="polite" role="status"></div>

	<!-- Progress bar (auto-rendered by wizard.js) -->
	<div id="wizard-progress"></div>

	<!-- Navigation buttons (auto-rendered) -->
	<div id="wizard-navigation"></div>

	<!-- Step content panels -->
	<div id="wizard-steps">
		<!-- Step 1: Schema Discovery -->
		<section id="step-1" class="wizard-step" style="display: block;">
			<div id="schema-content"></div>
		</section>

		<!-- Step 2: Build Mapping -->
		<section id="step-2" class="wizard-step" style="display: none;">
			<div id="mapping-content"></div>
		</section>

		<!-- Step 3: Create Plan -->
		<section id="step-3" class="wizard-step" style="display: none;">
			<div id="plan-content"></div>
		</section>

		<!-- Step 4: Execute Migration -->
		<section id="step-4" class="wizard-step" style="display: none;">
			<div id="run-content"></div>
		</section>

		<!-- Step 5: View Results -->
		<section id="step-5" class="wizard-step" style="display: none;">
			<div id="results-content"></div>
		</section>
	</div>

	<!-- Navigation buttons (auto-rendered) -->
	<div id="wizard-navigation"></div>

	<!-- Loading overlay -->
	<div class="loading-overlay" style="display: none;">
		<div class="loading-spinner">
			<div class="spinner"></div>
			<p>Loading...</p>
		</div>
	</div>
</div>

{{> results_modal}}

<!-- JavaScript - Load in order -->
<!-- 1. Core utilities -->
<script src="/public/js/utils/storage.js"></script>
<script src="/public/js/utils/state.js"></script>
<script src="/public/js/utils/validator.js"></script>
<script src="/public/js/utils/tableNameCanonical.js"></script>

<!-- 2. API clients -->
<script src="/public/js/api/client.js"></script>
<script src="/public/js/api/schema-api.js"></script>
<script src="/public/js/api/mapping-api.js"></script>
<script src="/public/js/api/plan-api.js"></script>
<script src="/public/js/api/run-api.js"></script>

<!-- 3. Step components -->
<script src="/public/js/steps/schema-ui.js"></script>
<script src="/public/js/steps/mapping-engine.js"></script>
<script src="/public/js/steps/mapping-ui.js"></script>
<script src="/public/js/steps/plan-ui.js"></script>
<script src="/public/js/steps/run-ui.js"></script>
<script src="/public/js/steps/results-ui.js"></script>

<!-- 4. Wizard controller (auto-initializes) -->
<script src="/public/js/wizard.js"></script>

<script>
	// Debug: Log when scripts load
	console.log('Wizard template loaded');
	console.log('WizardStorage available:', typeof WizardStorage !== 'undefined');
	console.log('WizardState available:', typeof WizardState !== 'undefined');
	console.log('MigrationWizard available:', typeof MigrationWizard !== 'undefined');
</script>