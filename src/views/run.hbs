<section class="card">
	<h2>Run migration</h2>
	{{#if error}}
	<div class="alert error">{{error}}</div>
	{{/if}}
	<form method="post" action="/run/start" id="run-form">
		<div class="actions">
			<a class="btn secondary" href="/mapping">Back</a>
			<button class="btn primary" type="submit" id="run-migration-btn">Run Migration</button>
			<button class="btn secondary" type="button" id="stop-run-btn">Stop run</button>
		</div>
		<div class="hint">This will migrate your selected tables in order. You can monitor progress below.</div>
		<div class="card nested" id="run-options">
			<div class="card-header">
				<strong>Advanced options</strong>
				<button class="btn secondary" type="button" data-toggle="run-options">Show</button>
			</div>
			<div class="card-body collapsed">
				<label>
					<input type="checkbox" name="dry_run" /> Dry run (no inserts)
				</label>
				<label>Batch size
					<input name="batch_size" value="500" />
				</label>
				<label>
					<input type="checkbox" name="fk_checks" checked /> Disable FK checks during load
				</label>
			</div>
		</div>
		<div class="card nested" id="clean-options">
			<div class="card-header">
				<strong>Clean target tables before migration</strong>
				<button class="btn secondary" type="button" data-toggle="clean-options">Show</button>
			</div>
			<div class="card-body collapsed">
				<div class="alert warning">This deletes all rows from the selected MySQL table(s). This cannot be
					undone.</div>
				<label>
					<input type="checkbox" name="clean_all" id="clean-all-toggle" /> Apply to all selected tables
				</label>
				<div class="hint">Pick tables to clean (only included plan tables are eligible).</div>
				<div class="clean-table-list" id="clean-table-list">
					{{#each plan}}
					{{#if include}}
					<label class="inline-label">
						<input type="checkbox" name="clean_table_{{table}}" class="clean-table-checkbox" /> {{table}}
					</label>
					{{/if}}
					{{/each}}
				</div>
				<div class="hint">Selected tables will be cleaned before migration.</div>
			</div>
		</div>
	</form>
</section>

<section class="card">
	<h3>Progress</h3>
	<div class="alert warning" id="conn-warning" hidden>
		<span id="conn-warning-text"></span>
	</div>
	<div id="progress" data-run-id="{{runId}}">
		<div class="alert error" id="progress-disconnected" hidden>Disconnected from progress updates. Reload.</div>
		<div class="alert error" id="run-failure-hint" hidden>Fix the issue, then click Run Migration again.</div>
		<div class="status" id="run-status-line">Status: {{#if run}}{{run.status}}{{else}}Idle{{/if}}</div>
		<div class="status" id="current-step">Current step: Not started</div>
		<div class="overall-progress">
			<div class="progress-bar">
				<div class="progress-bar-fill" id="overall-progress-fill"></div>
			</div>
			<div class="hint" id="overall-progress-text">0 of 0 tables completed</div>
		</div>
		<table class="progress-table">
			<thead>
				<tr>
					<th>Table</th>
					<th>Status</th>
					<th>Progress</th>
					<th>Skipped duplicates</th>
					<th>Errors</th>
				</tr>
			</thead>
			<tbody id="table-progress-body"></tbody>
		</table>
		{{#if runId}}
		<div class="actions">
			<a class="btn secondary" href="/results/{{runId}}">View Results</a>
		</div>
		{{/if}}
	</div>
	{{#unless runId}}
	<div class="hint">Start a run to see live progress.</div>
	{{/unless}}
</section>

<section class="card">
	<h3>Run log</h3>
	<div class="hint">Live debug log stream for this run.</div>
	<pre id="run-log" class="log-panel"></pre>
	{{#if runId}}
	<div class="actions">
		<a class="btn secondary" href="/run/logs/{{runId}}">Download log</a>
	</div>
	{{/if}}
</section>

<div class="modal" id="failure-modal" aria-hidden="true" role="dialog">
	<div class="modal-content modal-stack">
		<div>
			<h3>Migration stopped</h3>
			<p id="failure-message">The migration stopped.</p>
		</div>
		<div class="actions">
			<button class="btn primary" type="button" id="failure-details-btn">View details &amp; how to fix</button>
			<button class="btn secondary" type="button" data-modal-close="failure-modal">Close</button>
		</div>
	</div>
</div>

<div class="modal" id="fix-modal" aria-hidden="true" role="dialog">
	<div class="modal-content modal-stack">
		<div>
			<h3>How to fix</h3>
			<p><strong>Table:</strong> <span id="fix-table"></span></p>
			<p><strong>Step:</strong> <span id="fix-step"></span></p>
			<p><strong>Likely cause:</strong> <span id="fix-cause"></span></p>
			<p><strong>Error message:</strong></p>
			<button class="btn secondary" type="button" id="fix-details-toggle">Show debug details</button>
			<div id="fix-details" hidden>
				<textarea id="fix-error" class="error-textarea" readonly></textarea>
			</div>
			<p><strong>Steps to resolve:</strong></p>
			<ul id="fix-steps"></ul>
		</div>
		<div class="actions">
			<button class="btn secondary" type="button" data-modal-close="fix-modal">Close</button>
		</div>
	</div>
</div>

<div class="modal" id="table-success-modal" aria-hidden="true" role="dialog">
	<div class="modal-content modal-stack">
		<div>
			<h3>Table migration complete</h3>
			<p><strong>Table:</strong> <span id="table-success-name"></span></p>
			<p><strong>Mode:</strong> <span id="table-success-mode"></span></p>
			<p><strong>Cleaned first:</strong> <span id="table-success-cleaned"></span></p>
			<p><strong>Source rows:</strong> <span id="table-success-source"></span></p>
			<p><strong>Inserted:</strong> <span id="table-success-inserted"></span></p>
			<p><strong>Updated:</strong> <span id="table-success-updated"></span></p>
			<p><strong>Skipped:</strong> <span id="table-success-skipped"></span></p>
			<p><strong>Errors:</strong> <span id="table-success-errors"></span></p>
			<p><strong>Duration:</strong> <span id="table-success-duration"></span></p>
		</div>
		<div class="actions">
			<button class="btn primary" type="button" data-modal-close="table-success-modal">Close</button>
		</div>
	</div>
</div>

<div class="modal" id="success-modal" aria-hidden="true" role="dialog">
	<div class="modal-content modal-stack">
		<div>
			<h3>Migration completed</h3>
			<p id="success-summary">All tables migrated successfully.</p>
		</div>
		<div class="actions">
			<button class="btn primary" type="button" data-modal-close="success-modal">Done</button>
		</div>
	</div>
</div>