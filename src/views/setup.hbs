{{#if testResult}}
<script id="test-result-data" type="application/json">{{{json testResult}}}</script>
{{/if}}

<div class="modal" id="testResultModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="test-result-title">
	<div class="modal-content status-dialog" id="test-result-dialog">
		<header class="status-dialog-header">
			<span class="status-dialog-icon" aria-hidden="true"></span>
			<div class="status-dialog-heading">
				<h3 id="test-result-title">Connection result</h3>
				<p id="test-result-message"></p>
			</div>
			<button class="status-dialog-close" type="button" data-modal-close="testResultModal" aria-label="Close">&times;</button>
		</header>
		<div class="status-dialog-body" id="test-result-details" hidden></div>
		<footer class="status-dialog-footer">
			<button class="btn secondary" type="button" id="test-result-copy" hidden>Copy details</button>
			<div class="actions">
				<button class="btn primary" type="button" data-modal-close="testResultModal">Close</button>
			</div>
		</footer>
	</div>
</div>

<script src="/public/js/setupTestModal.js"></script>