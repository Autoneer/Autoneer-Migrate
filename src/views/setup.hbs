<section class="card setup-card">
	<form method="post" id="setup-form">
		<div class="setup-grid">
			<div class="setup-panel">
				<h3>Firebird <span class="setup-panel-sub">Legacy source</span></h3>
				<div class="setup-row setup-row-host">
					<label><span>Host</span>
						<input name="fb_host" value="{{firebird.host}}" />
					</label>
					<label><span>Port</span>
						<input name="fb_port" value="{{firebird.port}}" />
					</label>
				</div>
				<label><span>Database path</span>
					<input name="fb_database" value="{{firebird.database}}" />
				</label>
				<div class="setup-row">
					<label><span>User</span>
						<input name="fb_user" value="{{firebird.user}}" />
					</label>
					<label><span>Password</span>
						<input name="fb_password" type="password" value="masterkey" autocomplete="new-password" />
					</label>
				</div>
				<label class="setup-check">
					<input type="checkbox" name="fb_use_default" {{#if useDefaultSysdbaMasterkey}}checked{{/if}} />
					Use default SYSDBA/masterkey
				</label>
				<label><span>Role <em>(optional)</em></span>
					<input name="fb_role" value="{{firebird.role}}" />
				</label>
				<div class="setup-actions">
					<button class="btn primary" formaction="/setup/test-firebird" formmethod="post">Test Firebird</button>
					<div class="hint">Using Firebird user: {{firebirdUser}} • Password loaded: {{#if
						firebirdPasswordSet}}Yes{{else}}No{{/if}}</div>
				</div>
			</div>
			<div class="setup-panel">
				<h3>MySQL <span class="setup-panel-sub">Migration target</span></h3>
				<div class="setup-row setup-row-host">
					<label><span>Host</span>
						<input name="my_host" value="{{mysql.host}}" />
					</label>
					<label><span>Port</span>
						<input name="my_port" value="{{mysql.port}}" />
					</label>
				</div>
				<div class="setup-row">
					<label><span>User</span>
						<input name="my_user" value="{{mysql.user}}" />
					</label>
					<label><span>Password</span>
						<input name="my_password" type="password" value="" autocomplete="new-password" />
					</label>
				</div>
				<label><span>Target Schema</span>
					<input name="my_schema" value="{{schemaName}}" />
					<small class="hint">DDL schema name: {{ddlSchemaName}}</small>
				</label>
				<div class="setup-actions">
					<button class="btn primary" formaction="/setup/test-mysql" formmethod="post">Test MySQL</button>
					<button class="btn secondary" formaction="/setup/check-schema" formmethod="post">Check MySQL schema exists</button>
					<button class="btn secondary" formaction="/setup/create-schema" formmethod="post">Create schema from DDL</button>
				</div>
			</div>
		</div>
	</form>
</section>

<section class="card setup-card">
	<h3 class="setup-card-title">Diagnostics</h3>
	{{#if diagnostics}}
	<div class="setup-grid">
		<div class="setup-panel">
			<h4>Firebird</h4>
			<dl class="setup-diag">
				<dt>Host</dt><dd>{{diagnostics.firebird.host}}</dd>
				<dt>Port</dt><dd>{{diagnostics.firebird.port}}</dd>
				<dt>Database</dt><dd>{{diagnostics.firebird.database}}</dd>
				<dt>User</dt><dd>{{diagnostics.firebird.user}}</dd>
				<dt>Password set</dt><dd>{{#if diagnostics.firebird.passwordSet}}Yes{{else}}No{{/if}}</dd>
				{{#if diagnostics.firebird.passwordSource}}
				<dt>Password source</dt><dd>{{diagnostics.firebird.passwordSource}}</dd>
				{{/if}}
				<dt>Default SYSDBA/masterkey</dt><dd>{{#if diagnostics.firebird.useDefaultSysdbaMasterkey}}Enabled{{else}}Disabled{{/if}}</dd>
			</dl>
		</div>
		<div class="setup-panel">
			<h4>MySQL</h4>
			<dl class="setup-diag">
				<dt>Host</dt><dd>{{diagnostics.mysql.host}}</dd>
				<dt>Port</dt><dd>{{diagnostics.mysql.port}}</dd>
				<dt>User</dt><dd>{{diagnostics.mysql.user}}</dd>
				<dt>Password set</dt><dd>{{#if diagnostics.mysql.passwordSet}}Yes{{else}}No{{/if}}</dd>
				<dt>Schema</dt><dd>{{diagnostics.mysql.schemaName}}</dd>
			</dl>
		</div>
	</div>
	{{/if}}
</section>

