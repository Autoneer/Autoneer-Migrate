<link rel="stylesheet" href="/public/css/theme-github.css">
<div class="gh-page">
	<div class="gh-container">
		<div class="gh-toolbar">
			<h2>Migration Run #{{run.run_id}}</h2>
			<button class="gh-theme-toggle" type="button" data-theme-toggle>Toggle theme</button>
		</div>
		{{#if error}}<div class="gh-banner gh-danger">{{error}}</div>{{/if}}
		<div class="gh-cards">
			<div class="gh-card">
				<strong>Label</strong>
				<div class="mono">{{run.run_label}}</div>
			</div>
			<div class="gh-card">
				<strong>Status</strong>
				<div><span class="gh-badge gh-{{run.status}}">{{run.status}}</span></div>
			</div>
			<div class="gh-card">
				<strong>Started</strong>
				<div>{{formatDate run.started_at}}</div>
			</div>
			<div class="gh-card">
				<strong>Ended</strong>
				<div>{{formatDate run.ended_at}}</div>
			</div>
			<div class="gh-card">
				<strong>Errors</strong>
				<div>{{run.error_count}}</div>
			</div>
		</div>
		<div class="actions">
			<form method="post" action="/migration/history/{{run.run_id}}/delete"
				onsubmit="return confirm('Delete this run and all related records?');">
				<button class="btn secondary" type="submit">Delete run</button>
			</form>
		</div>

		<h3>Per-table summary</h3>
		<pre class="mono">{{json run.table_summary_json}}</pre>

		<h3>Errors</h3>
		<table class="gh-table">
			<thead>
				<tr>
					<th>Table</th>
					<th>Source PK</th>
					<th>Message</th>
					<th>When</th>
				</tr>
			</thead>
			<tbody>
				{{#each errors}}
				<tr>
					<td>{{table_name}}</td>
					<td class="mono">{{source_pk}}</td>
					<td>{{message}}</td>
					<td>{{formatDate created_at}}</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
	</div>
</div>

<script>
	(function () {
		const key = 'autoneer-migration-theme';
		const current = 'light';
		document.body.setAttribute('data-theme', current);
		localStorage.setItem(key, current);
		const content = document.querySelector('.content');
		if (content) content.classList.add('gh-content-light');
		const btn = document.querySelector('[data-theme-toggle]');
		if (btn) {
			btn.addEventListener('click', function () {
				const next = document.body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
				document.body.setAttribute('data-theme', next);
				localStorage.setItem(key, next);
				if (content) {
					if (next === 'dark') {
						content.classList.remove('gh-content-light');
					} else {
						content.classList.add('gh-content-light');
					}
				}
			});
		}
	})();
</script>