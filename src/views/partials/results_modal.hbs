<div id="results-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" style="display:none;">
	<style>
		/* Simplified modern modal design */
		:root {
			--color-bg-primary: #ffffff;
			--color-bg-secondary: #f9fafb;
			--color-text-primary: #111827;
			--color-text-secondary: #6b7280;
			--color-border: #e5e7eb;
			--color-accent: #3b82f6;
			--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
			--transition: 150ms ease-out;
		}

		#results-modal {
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.5);
			display: flex;
			align-items: center;
			justify-content: center;
			z-index: 1000;
		}

		#results-modal .modal-dialog {
			max-width: 960px;
			width: 90%;
			max-height: 90vh;
			background: var(--color-bg-primary);
			border-radius: 12px;
			box-shadow: var(--shadow-sm);
			display: flex;
			flex-direction: column;
			overflow: hidden;
		}

		/* Header */
		#results-modal .modal-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 16px 24px;
			border-bottom: 1px solid var(--color-border);
		}

		#results-modal .modal-header-content {
			flex: 1;
			display: flex;
			align-items: center;
			gap: 16px;
		}

		#results-modal h3 {
			margin: 0;
			font-size: 1.25rem;
			font-weight: 600;
			color: var(--color-text-primary);
		}

		#results-modal .modal-meta {
			display: flex;
			gap: 16px;
			align-items: center;
		}

		#results-modal .meta-item {
			display: flex;
			align-items: center;
			gap: 4px;
			font-size: 0.875rem;
		}

		#results-modal .meta-label {
			font-weight: 500;
			color: var(--color-text-secondary);
		}

		#results-modal .meta-value {
			color: var(--color-text-primary);
			font-weight: 500;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		/* Close button */
		#results-modal .modal-close {
			flex-shrink: 0;
			width: 32px;
			height: 32px;
			border: none;
			background: transparent;
			border-radius: 6px;
			cursor: pointer;
			color: var(--color-text-secondary);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 20px;
			transition: background var(--transition), color var(--transition);
		}

		#results-modal .modal-close:hover {
			background: var(--color-bg-secondary);
			color: var(--color-text-primary);
		}

		/* Body */
		#results-modal .modal-body {
			flex: 1;
			padding: 24px;
			overflow-y: auto;
		}

		/* Scrollbar styling */
		#results-modal .modal-body::-webkit-scrollbar {
			width: 6px;
		}

		#results-modal .modal-body::-webkit-scrollbar-track {
			background: transparent;
		}

		#results-modal .modal-body::-webkit-scrollbar-thumb {
			background: var(--color-border);
			border-radius: 3px;
		}

		#results-modal .modal-body::-webkit-scrollbar-thumb:hover {
			background: var(--color-text-secondary);
		}

		/* Results grid */
		#results-modal .results-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 16px;
		}

		/* Result panels */
		#results-modal .results-panel {
			background: var(--color-bg-secondary);
			border: 1px solid var(--color-border);
			border-radius: 8px;
			padding: 16px;
			transition: border-color var(--transition);
		}

		#results-modal .results-panel:hover {
			border-color: var(--color-accent);
		}

		/* Responsive */
		@media (max-width: 768px) {
			#results-modal .modal-dialog {
				width: 95%;
				max-height: 95vh;
			}

			#results-modal .modal-header {
				padding: 12px 16px;
			}

			#results-modal h3 {
				font-size: 1.125rem;
			}

			#results-modal .modal-meta {
				flex-direction: column;
				align-items: flex-start;
				gap: 4px;
			}

			#results-modal .modal-body {
				padding: 16px;
			}

			#results-modal .results-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<div class="modal-dialog modal-xl">
		<div class="modal-header">
			<div class="modal-header-content">
				<h3>Migration Results</h3>
				<div class="modal-meta" aria-hidden="true">
					<div class="meta-item" title="Profile">
						<span class="meta-label">Profile:</span>
						<span class="meta-value" id="results-profile-name">(not set)</span>
					</div>
					<div class="meta-item" title="Plan">
						<span class="meta-label">Plan:</span>
						<span class="meta-value" id="results-plan-name">(not set)</span>
					</div>
				</div>
			</div>

			<button class="modal-close" type="button" data-results-close aria-label="Close results">×</button>
		</div>

		<div class="modal-body">
			<div id="results-modal-content">
				<div class="results-grid">
					<div class="results-panel" id="results-summary-panel">
						<!-- Summary content injected here -->
					</div>
					<div class="results-panel" id="results-details-panel">
						<!-- Detailed results injected here -->
					</div>
				</div>
			</div>
		</div>
	</div>
</div>