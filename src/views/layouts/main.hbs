<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Autoneer Migration Wizard</title>
	<link rel="manifest" href="/public/manifest.webmanifest" />
	<link rel="stylesheet" href="/public/css/styles.css" />
	<link rel="stylesheet" href="/public/css/modal.css" />
	<link rel="stylesheet" href="/public/css/theme-github.css" />
</head>

<body data-page="{{currentStep}}">
	<div class="app">
		{{> sidebar currentStep=currentStep}}
		<main class="content">
			<div class="topbar">
				<div class="conn-status" id="conn-status" role="button" tabindex="0" aria-label="Connection status">
					<span class="conn-title">Connection Status</span>
					<span id="conn-badge-firebird" class="conn-badge">Firebird: Checking...</span>
					<span id="conn-badge-mysql" class="conn-badge">MySQL: Checking...</span>
				</div>
			</div>
			{{#if message}}
			<div class="alert success">{{message}}</div>
			{{/if}}
			{{#if error}}
			<div class="alert error">{{error}}</div>
			{{/if}}
			{{{body}}}
		</main>
	</div>
	<div class="modal" id="conn-modal" aria-hidden="true" role="dialog">
		<div class="modal-content modal-stack">
			<div>
				<h3>Connection details</h3>
				<p><strong>Firebird:</strong> <span id="conn-modal-firebird-status"></span></p>
				<p class="hint" id="conn-modal-firebird-details"></p>
				<p><strong>MySQL:</strong> <span id="conn-modal-mysql-status"></span></p>
				<p class="hint" id="conn-modal-mysql-details"></p>
				<p class="hint">Last checked: <span id="conn-last-checked">-</span></p>
			</div>
			<div class="actions">
				<button class="btn primary" type="button" id="conn-recheck-btn">Recheck now</button>
				<button class="btn secondary" type="button" data-modal-close="conn-modal">Close</button>
			</div>
		</div>
	</div>
	<script src="/public/js/utils/modal.js"></script>
	<script src="/public/js/app.js"></script>
	<script src="/public/js/connectionStatus.js"></script>
</body>

</html>