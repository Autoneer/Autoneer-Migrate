<section class="card">
	<h2>Mapping</h2>
	<p class="hint">Fix any mismatched fields below. Most users only need this.</p>
	<label>
		<input type="checkbox" id="mapping-advanced-toggle" />
		Show advanced options
	</label>
</section>

{{#if mappingNotice}}
<section class="card">
	<div class="status">{{mappingNotice.message}}</div>
	{{#if mappingNotice.details}}
	<div class="hint">{{mappingNotice.details}}</div>
	{{/if}}
</section>
{{/if}}

<section class="card">
	<h3>Fields needing attention</h3>
	<p class="hint">Only fields that need action are shown.</p>
	{{#if mismatchRows.length}}
	<form method="post" action="/mapping/resolve">
		<table>
			<thead>
				<tr>
					<th>Source table</th>
					<th>Missing field</th>
					<th>Target field</th>
					<th>Resolve to</th>
				</tr>
			</thead>
			<tbody>
				{{#each mismatchRows}}
				<tr>
					<td>{{sourceTable}}</td>
					<td>{{sourceColumn}}</td>
					<td>{{targetColumn}}</td>
					<td>
						<select name="resolve__{{mappingKey}}__{{sourceColumn}}">
							<option value="">— Choose a replacement field —</option>
							<option value="__omit__">Omit (do not import this field)</option>
							{{#each availableSourceColumns}}
							<option value="{{this}}">{{this}}</option>
							{{/each}}
						</select>
					</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
		<div class="actions">
			<button class="btn primary" type="submit">Apply fixes</button>
		</div>
		<div class="hint">This updates your current mapping. Save to a profile to keep it.</div>
	</form>
	{{else}}
	<div class="hint">All good — no mismatches found.</div>
	<div class="actions">
		<a class="btn primary" href="/run">Continue to Run</a>
	</div>
	{{/if}}
</section>

<section class="card">
	<h3>Current profile</h3>
	<div class="hint">A profile is a saved set of mapping rules. Use it if you migrate more than once.</div>
	{{#if activeMappingProfileId}}
	<div>
		Current profile: <strong>{{activeMappingProfileName}}</strong> <span class="pill">Loaded</span>
		{{#if (eq defaultMappingProfileId activeMappingProfileId)}}
		<span class="pill">Default</span>
		{{/if}}
	</div>
	<div class="hint">Default profile loads automatically next time.</div>
	{{else}}
	<div class="hint">No profile selected yet (changes are temporary until saved).</div>
	{{/if}}
	<form method="post" action="/mapping/save">
		<input type="hidden" name="profile_id" value="{{activeMappingProfileId}}" />
		<label>Save mapping as a profile (recommended)
			<input name="profile_name" placeholder="Default Autoneer Firebird" value="{{activeMappingProfileName}}" />
		</label>
		<div class="hint">Give this mapping a name so you can reuse it later (e.g. “Default Autoneer Firebird”).</div>
		<label>
			<input type="checkbox" name="save_as_new" />
			Create a new profile (instead of updating the loaded profile)
		</label>
		<div class="advanced-section" data-advanced-section style="display: none;">
			<h4>Advanced: Mapping JSON</h4>
			<label>Mapping JSON</label>
			<textarea name="mapping_json" class="code" rows="24" style="width: 100%;">{{mappingJson}}</textarea>
		</div>
		<div class="actions">
			<a class="btn secondary" href="/plan">Back</a>
			<button class="btn primary" type="submit">Save profile & continue to Run</button>
		</div>
	</form>
</section>

<section class="card advanced-section" data-advanced-section style="display: none;">
	<h3>Advanced: Custom Table Mapping</h3>
	<div class="hint">Map source tables to different target table names and select which fields to migrate.</div>
	<form method="post" action="/mapping/customize">
		<table>
			<thead>
				<tr>
					<th>Source Table</th>
					<th>Target Table</th>
					<th>Fields to Migrate</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{{#each mappingTables}}
				<tr>
					<td><strong>{{source}}</strong></td>
					<td>
						<select name="target__{{source}}" class="target-table-selector" data-source="{{source}}"
							style="width: 100%;" onchange="onTargetTableChange('{{source}}', this.value)">
							<option value="">— Select target table —</option>
							{{#each ../availableTargetTables}}
							<option value="{{this}}" {{#if (eq this ../target)}}selected{{/if}}>{{this}}</option>
							{{/each}}
							<option value="__custom__">✏️ Custom table name...</option>
						</select>
						<input type="text" name="target_custom__{{source}}" id="target-custom-{{source}}"
							placeholder="Enter custom table name"
							style="display: none; width: 100%; margin-top: 5px;" />
					</td>
					<td>
						<button type="button" class="btn secondary" onclick="showFieldSelector('{{source}}')">
							Configure Fields ({{columns.length}})
						</button>
					</td>
					<td>
						<button type="button" class="btn secondary"
							onclick="duplicateTableMapping('{{source}}', '{{target}}')">
							Duplicate
						</button>
					</td>
				</tr>
				<!-- Hidden field selector modal -->
				<tr id="field-selector-{{source}}" style="display: none;">
					<td colspan="4">
						<div style="padding: 10px; background: #f5f5f5; border-radius: 4px;">
							<h4>Map fields: {{source}} → <span id="target-name-{{source}}">{{target}}</span></h4>
							<div id="field-mapping-container-{{source}}">
								<div style="max-height: 300px; overflow-y: auto;">
									<table style="width: 100%;">
										<thead>
											<tr>
												<th style="width: 30px;">
													<input type="checkbox"
														onchange="toggleAllFields('{{source}}', this.checked)" />
												</th>
												<th>Source Field</th>
												<th>→</th>
												<th>Target Field</th>
												<th>Transform</th>
												<th>Default Value</th>
											</tr>
										</thead>
										<tbody id="field-mapping-body-{{source}}">
											{{#each columns}}
											<tr>
												<td>
													<input type="checkbox"
														name="field_include__{{../source}}__{{source}}" value="1"
														checked class="field-checkbox-{{../source}}" />
												</td>
												<td><strong>{{source}}</strong></td>
												<td>→</td>
												<td>
													<select name="field_target__{{../source}}__{{source}}"
														style="width: 100%;" class="target-field-selector">
														<option value="">— Select target field —</option>
														<option value="{{target}}" selected>{{target}}</option>
													</select>
												</td>
												<td>
													<select name="field_transform__{{../source}}__{{source}}">
														<option value="">None</option>
														<option value="trim" {{#if (eq transform "trim"
															)}}selected{{/if}}>
															trim</option>
														<option value="toNumber" {{#if (eq transform "toNumber"
															)}}selected{{/if}}>toNumber</option>
														<option value="toDate" {{#if (eq transform "toDate"
															)}}selected{{/if}}>toDate</option>
														<option value="toUpperCase" {{#if (eq transform "toUpperCase"
															)}}selected{{/if}}>toUpperCase</option>
														<option value="toLowerCase" {{#if (eq transform "toLowerCase"
															)}}selected{{/if}}>toLowerCase</option>
													</select>
												</td>
												<td>
													<input type="text" name="field_default__{{../source}}__{{source}}"
														value="{{defaultValue}}" placeholder="(optional)"
														style="width: 100%;" />
												</td>
											</tr>
											{{/each}}
										</tbody>
									</table>
								</div>
							</div>
							<div style="margin-top: 10px;">
								<button type="button" class="btn secondary" onclick="hideFieldSelector('{{source}}')">
									Done
								</button>
								<button type="button" class="btn secondary"
									onclick="loadTargetTableFields('{{source}}')">
									🔄 Refresh Target Fields
								</button>
							</div>
						</div>
					</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
		<div class="hint">
			<strong>Example:</strong> To migrate SPARES_USED to customer_invoice_lines, change the target table name
			and configure which fields to include.
		</div>
		<div class="actions">
			<button class="btn primary" type="submit">Apply Custom Mapping</button>
		</div>
	</form>
</section>

<section class="card advanced-section" data-advanced-section style="display: none;">
	<h3>Advanced: Import / Export</h3>
	<form method="post" action="/mapping/import">
		<textarea name="mapping_json" class="code" rows="10" placeholder="Paste mapping JSON here"></textarea>
		<div class="actions">
			<button class="btn" type="submit">Import</button>
		</div>
	</form>
	<div class="actions">
		<form method="get" action="/mapping/export">
			<button class="btn secondary" type="submit">Export JSON</button>
		</form>
	</div>
</section>

<section class="card advanced-section" data-advanced-section style="display: none;">
	<h3>Advanced: Profiles</h3>
	<div class="hint">Loaded means this profile is currently active. Default profile loads automatically next time.
	</div>
	{{#if profiles.length}}
	<table>
		<thead>
			<tr>
				<th>Name</th>
				<th>Created</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{{#each profiles}}
			<tr>
				<td>
					{{name}}
					{{#if (eq ../defaultMappingProfileId id)}}
					<span class="pill">Default</span>
					{{/if}}
					{{#if (eq ../activeMappingProfileId id)}}
					<span class="pill">Loaded</span>
					{{/if}}
				</td>
				<td>{{formatDate created_at 'date'}}</td>
				<td>
					<div class="actions">
						<a class="btn" href="/mapping/profile/{{id}}">Load</a>
						<form method="post" action="/mapping/profile/{{id}}/default">
							<button class="btn secondary" type="submit">Set Default</button>
						</form>
						<form method="post" action="/mapping/profile/{{id}}/delete"
							onsubmit="return confirm('Delete this profile?');">
							<button class="btn" type="submit">Delete</button>
						</form>
					</div>
				</td>
			</tr>
			{{/each}}
		</tbody>
	</table>
	{{else}}
	<div class="hint">No saved profiles yet.</div>
	{{/if}}
</section>

<script>
	(function () {
		const toggle = document.getElementById("mapping-advanced-toggle");
		const sections = document.querySelectorAll("[data-advanced-section]");
		const storageKey = "mappingAdvanced";
		const setVisible = (enabled) => {
			sections.forEach((section) => {
				section.style.display = enabled ? "block" : "none";
			});
		};
		const stored = window.localStorage ? window.localStorage.getItem(storageKey) : null;
		const enabled = stored === "1";
		if (toggle) {
			toggle.checked = enabled;
			setVisible(enabled);
			toggle.addEventListener("change", () => {
				const isOn = toggle.checked;
				if (window.localStorage) {
					window.localStorage.setItem(storageKey, isOn ? "1" : "0");
				}
				setVisible(isOn);
			});
		}

		// Store target table schemas from server
		const targetTableSchemas = {{{ targetTableSchemasJson }}};
	// Field selector functions
	window.showFieldSelector = function (sourceTable) {
		const row = document.getElementById('field-selector-' + sourceTable);
		if (row) row.style.display = 'table-row';
	};

	window.hideFieldSelector = function (sourceTable) {
		const row = document.getElementById('field-selector-' + sourceTable);
		if (row) row.style.display = 'none';
	};

	window.toggleAllFields = function (sourceTable, checked) {
		const checkboxes = document.querySelectorAll('.field-checkbox-' + sourceTable);
		checkboxes.forEach(cb => cb.checked = checked);
	};

	window.onTargetTableChange = function (sourceTable, targetTableName) {
		const customInput = document.getElementById('target-custom-' + sourceTable);
		const targetNameSpan = document.getElementById('target-name-' + sourceTable);

		if (targetTableName === '__custom__') {
			// Show custom input
			customInput.style.display = 'block';
			customInput.focus();
			if (targetNameSpan) targetNameSpan.textContent = 'Custom';
		} else {
			// Hide custom input
			customInput.style.display = 'none';
			if (targetNameSpan) targetNameSpan.textContent = targetTableName || 'None';

			// Load target table fields if available
			if (targetTableName && targetTableSchemas[targetTableName]) {
				updateTargetFieldDropdowns(sourceTable, targetTableSchemas[targetTableName]);
			}
		}
	};

	window.loadTargetTableFields = async function (sourceTable) {
		const selector = document.querySelector(`select[name="target__${sourceTable}"]`);
		if (!selector) return;

		const targetTableName = selector.value;
		if (!targetTableName || targetTableName === '__custom__') {
			alert('Please select a target table first');
			return;
		}

		try {
			const response = await fetch(`/mapping/api/target-table-fields/${encodeURIComponent(targetTableName)}`);
			const data = await response.json();

			if (data.ok && data.columns) {
				targetTableSchemas[targetTableName] = data.columns;
				updateTargetFieldDropdowns(sourceTable, data.columns);
				alert(`Loaded ${data.columns.length} fields from ${targetTableName}`);
			} else {
				alert('Failed to load target table fields: ' + (data.error || 'Unknown error'));
			}
		} catch (err) {
			alert('Error loading target table fields: ' + err.message);
		}
	};

	function updateTargetFieldDropdowns(sourceTable, targetColumns) {
		const tbody = document.getElementById('field-mapping-body-' + sourceTable);
		if (!tbody) return;

		const rows = tbody.querySelectorAll('tr');
		rows.forEach(row => {
			const targetSelect = row.querySelector('.target-field-selector');
			if (!targetSelect) return;

			// Get current selection
			const currentValue = targetSelect.value;

			// Clear and rebuild options
			targetSelect.innerHTML = '<option value="">— Select target field —</option>';

			// Add all target table columns
			targetColumns.forEach(col => {
				const option = document.createElement('option');
				option.value = col.name;
				option.textContent = col.name + (col.isPrimary ? ' 🔑' : '') + ' (' + col.dataType + ')';
				if (col.name === currentValue) {
					option.selected = true;
				}
				targetSelect.appendChild(option);
			});

			// Add custom option
			const customOption = document.createElement('option');
			customOption.value = '__custom__';
			customOption.textContent = '✏️ Custom field name...';
			targetSelect.appendChild(customOption);
		});
	}

	window.duplicateTableMapping = function (sourceTable, targetTable) {
		const newTargetName = prompt('Enter new target table name for ' + sourceTable + ':', targetTable + '_copy');
		if (newTargetName && newTargetName.trim()) {
			const input = document.querySelector('input[name="target__' + sourceTable + '"]');
			if (input) {
				// Create a visual indication or handle duplication
				alert('To duplicate, create a new mapping entry in the JSON editor or use the export/import feature.');
			}
		}
	};

	// Initialize target field dropdowns on page load
	document.addEventListener('DOMContentLoaded', function () {
		// Pre-populate target field dropdowns for already selected tables
		const selectors = document.querySelectorAll('.target-table-selector');
		selectors.forEach(selector => {
			const sourceTable = selector.getAttribute('data-source');
			const targetTable = selector.value;
			if (targetTable && targetTable !== '__custom__' && targetTableSchemas[targetTable]) {
				updateTargetFieldDropdowns(sourceTable, targetTableSchemas[targetTable]);
			}
		});
	});
	}) ();
</script>