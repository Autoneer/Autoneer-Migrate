<link rel="stylesheet" href="/public/css/theme-github.css">
<div class="gh-page">
	<div class="gh-container">
		<div class="gh-toolbar">
			<h2>Migration History</h2>
			<button class="gh-theme-toggle" type="button" data-theme-toggle>Toggle theme</button>
		</div>
		{{#if error}}<div class="gh-banner gh-danger">{{error}}</div>{{/if}}
		<div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
			<form id="flushHistoryForm" method="post" action="/migration/history/flush"
				data-confirm="Flush all migration history? This will permanently delete ALL migration runs, errors, plans and related data. This cannot be undone."
				style="display:inline;">
				<button class="gh-btn gh-danger gh-outline" type="submit">Flush History</button>
			</form>
			<span style="color:#666;font-size:0.9em;">Use with caution — permanently deletes all migration
				history.</span>
		</div>
		<form id="batchDeleteForm" method="post" action="/migration/history/delete"
			data-confirm="Delete selected runs and all related records? This cannot be undone.">
			<div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
				<button class="gh-btn gh-danger" type="submit">Delete Selected</button>
				<span style="color:#666;font-size:0.9em;">Select runs to delete using the checkboxes.</span>
			</div>
			<table class="gh-table">
				<thead>
					<tr>
						<th style="width:26px"><input id="selectAll" type="checkbox" aria-label="Select all runs"></th>
						<th>Run</th>
						<th>Started</th>
						<th>Ended</th>
						<th>Status</th>
						<th>Errors</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{{#each runs}}
					<tr>
						<td><input class="rowSelect" type="checkbox" name="run_ids" value="{{run_id}}"
								aria-label="Select run {{run_id}}"></td>
						<td>{{run_label}} (#{{run_id}})</td>
						<td>{{formatDate started_at}}</td>
						<td>{{formatDate ended_at}}</td>
						<td><span class="gh-badge gh-{{status}}">{{status}}</span></td>
						<td>{{error_count}}</td>
						<td>
							<div class="gh-actions" style="display:flex;gap:8px;align-items:center;">
								<a class="gh-btn" href="/migration/history/{{run_id}}">View</a>
								<form method="post" action="/migration/history/{{run_id}}/delete"
									data-confirm="Delete run #{{run_id}} and all related records? This cannot be undone.">
									<button class="gh-btn gh-btn-sm gh-danger" type="submit">Delete</button>
								</form>
								{{#if (eq status 'SUCCESS')}}
								{{#if plan_id}}
								<form method="post" action="/migration/plans/{{plan_id}}/reuse">
									<button class="gh-btn gh-btn-sm" type="submit">Reuse plan</button>
								</form>
								{{/if}}
								{{else}}
								<form method="post" action="/migration/plans/{{plan_id}}/reuse">
									<button class="gh-btn gh-btn-sm gh-warning" type="submit">Clone plan</button>
								</form>
								{{/if}}
							</div>
						</td>
					</tr>
					{{/each}}
				</tbody>
			</table>
		</form>
	</div>
</div>

<script>
	(function () {
		const key = 'autoneer-migration-theme';
		const current = 'light';
		document.body.setAttribute('data-theme', current);
		localStorage.setItem(key, current);
		const content = document.querySelector('.content');
		if (content) content.classList.add('gh-content-light');
		const btn = document.querySelector('[data-theme-toggle]');
		if (btn) {
			btn.addEventListener('click', function () {
				const next = document.body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
				document.body.setAttribute('data-theme', next);
				localStorage.setItem(key, next);
				if (content) {
					if (next === 'dark') {
						content.classList.remove('gh-content-light');
					} else {
						content.classList.add('gh-content-light');
					}
				}
			});
		}

		// select-all checkbox for batch deletion
		const selectAll = document.getElementById('selectAll');
		if (selectAll) {
			selectAll.addEventListener('change', function () {
				const rows = document.querySelectorAll('.rowSelect');
				rows.forEach(r => { r.checked = selectAll.checked; });
			});
			// keep header checkbox in sync when user toggles individual rows
			const rowCheckboxes = document.querySelectorAll('.rowSelect');
			rowCheckboxes.forEach(cb => cb.addEventListener('change', function () {
				const all = Array.from(document.querySelectorAll('.rowSelect'));
				selectAll.checked = all.length > 0 && all.every(i => i.checked);
			}));
		}
	})();
</script>

<script>
	// Intercept forms with data-confirm and use Modal.confirm (flash modal) when available
	(function () {
		const forms = document.querySelectorAll('form[data-confirm]');
		if (!forms || !forms.length) return;
		forms.forEach(form => {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const message = form.getAttribute('data-confirm') || 'Are you sure?';
				try {
					if (window.Modal && typeof Modal.confirm === 'function') {
						const confirmed = await Modal.confirm({
							title: 'Confirm',
							message: message,
							type: 'warning',
							confirmText: 'Continue',
							cancelText: 'Cancel'
						});
						if (confirmed) {
							form.submit();
						}
					} else {
						if (window.confirm(message)) form.submit();
					}
				} catch (err) {
					// fallback to native confirm on error
					if (window.confirm(message)) form.submit();
				}
			});
		});
	})();
</script>